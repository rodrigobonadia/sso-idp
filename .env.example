# Copy this file to .env and adjust as needed. docker-compose.yml reads these automatically.
DB_NAME=sso
DB_USER=sso
DB_PASSWORD=change-me
DB_PORT=5432
APP_PORT=8080

# Base domain used to resolve the tenant from a request's subdomain (see TenantResolutionFilter).
# Locally, "localhost" works out of the box (acme.localhost resolves without any DNS/hosts setup
# on modern browsers). In production, set this to the platform's real domain.
TENANT_BASE_DOMAIN=localhost
